# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# test artifacts
/artifacts
/test-results
/playwright-report

# typescript
*.tsbuildinfo
next-env.d.ts

# generated assets — source sheets are gitignored, but extracted runtime
# sprites and the manifest MUST be committed so the production build works.
# See scripts/extract-character.mjs and scripts/extract-environment.mjs.

# generated screenshots and sequences
/shots
/shots2
/shots3
/shots4
/refshots
/seq1
/seq2
/seq3
/seq4
/seq5
/seq6
/seq7

# AI-generated reference images
ChatGPT Image*

# local tool config
/.claude
